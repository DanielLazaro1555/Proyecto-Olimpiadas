# Copia este archivo a .env y completa los valores
# cp .env.example .env

# Clave secreta para firmar los tokens JWT
# Genera una segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=u22326979

# Entorno de ejecución: development | production
FLASK_ENV=development

# Depuración del servidor Flask cuando se ejecuta sin gunicorn
FLASK_DEBUG=false

# Puerto expuesto por la aplicación
PORT=5000

# Ruta del archivo SQLite al ejecutar localmente desde ./app
DATABASE_PATH=olimpiadas.db
