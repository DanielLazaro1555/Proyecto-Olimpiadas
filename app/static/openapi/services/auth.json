{
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Iniciar sesión",
        "description": "Autentica al usuario y retorna un token JWT junto con los datos de rol y username.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "admin" },
                  "password": { "type": "string", "example": "admin123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
                    "username": { "type": "string", "example": "admin" },
                    "rol": { "type": "string", "example": "admin" }
                  }
                }
              }
            }
          },
          "400": { "description": "Usuario y contraseña requeridos" },
          "401": { "description": "Credenciales inválidas" }
        }
      }
    },
    "/auth/registro": {
      "post": {
        "summary": "Registrar nuevo usuario",
        "description": "Crea una cuenta nueva en el sistema. Requiere token de administrador.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "operador2" },
                  "password": { "type": "string", "example": "operador123" },
                  "rol": { "type": "string", "enum": ["admin", "operador", "visualizador"], "example": "operador" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario registrado con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": { "type": "string", "example": "Usuario 'operador2' registrado exitosamente" }
                  }
                }
              }
            }
          },
          "400": { "description": "Usuario/contraseña inválidos (formato, longitud) o rol inválido" },
          "401": { "description": "Token requerido o inválido" },
          "403": { "description": "Permisos insuficientes (solo admin)" },
          "409": { "description": "El nombre de usuario ya existe" }
        }
      }
    },
    "/auth/usuarios": {
      "get": {
        "summary": "Listar todos los usuarios",
        "description": "Devuelve la lista de usuarios registrados. Requiere token de administrador.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de usuarios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer", "example": 1 },
                      "username": { "type": "string", "example": "admin" },
                      "rol": { "type": "string", "example": "admin" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Token requerido" },
          "403": { "description": "Permisos insuficientes" }
        }
      }
    },
    "/auth/usuarios/{usuario_id}": {
      "delete": {
        "summary": "Eliminar un usuario",
        "description": "Elimina un usuario por su ID. No permite auto-eliminación. Requiere token de administrador.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "usuario_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario eliminado con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": { "type": "string", "example": "Usuario eliminado correctamente" }
                  }
                }
              }
            }
          },
          "401": { "description": "Token requerido" },
          "403": { "description": "Permisos insuficientes" },
          "404": { "description": "Usuario no encontrado" },
          "409": { "description": "No puedes eliminar tu propia cuenta" }
        }
      }
    },
    "/auth/auditoria": {
      "get": {
        "summary": "Consultar historial de auditoría",
        "description": "Devuelve la lista de transacciones registradas por auditoría. Requiere token de administrador.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Historial de auditorías",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer", "example": 12 },
                      "fecha_hora": { "type": "string", "example": "2026-07-06 11:30:15" },
                      "username": { "type": "string", "example": "admin" },
                      "rol": { "type": "string", "example": "admin" },
                      "metodo": { "type": "string", "example": "POST" },
                      "ruta": { "type": "string", "example": "/equipos/" },
                      "payload": { "type": "string", "example": "{\"region\": \"Lima\", \"deporte\": \"Futbol\", \"nombre_equipo\": \"Los Halcones\"}" },
                      "status_code": { "type": "integer", "example": 201 }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Token requerido" },
          "403": { "description": "Permisos insuficientes" }
        }
      }
    }
  }
}
